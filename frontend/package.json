{
  "name": "scaspa-chatbot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build && npm run lint && npm run typecheck && npm run test",
    "check:responsive": "node scripts/responsive-check.mjs",
    "check:streaming": "node scripts/streaming-perf.mjs",
    "check:integration": "node scripts/integration-check.mjs",
    "check:slow": "node scripts/slow-network-check.mjs",
    "check:charts": "node scripts/chart-check.mjs",
    "check:budget": "node scripts/bundle-budget.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "check:browsers": "node scripts/cross-browser-check.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "playwright": "1.56.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vite-plugin-checker": "0.14.5",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
