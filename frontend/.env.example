# Copy to .env.local and fill in. .env.local is gitignored.
#
# Vite only exposes variables prefixed VITE_ to the browser. Everything here is
# therefore PUBLIC — it ships in the bundle. Never put a secret in this file.
# There is no API key in the frontend and there never will be: the backend holds
# it. See frontend/CLAUDE.md rule 2.

# Backend base URL, no trailing slash.
# Local backend: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Serve the API from MSW fixtures instead of a real backend. Dev only; the mock
# code is not bundled in a production build at all.
#
# Off by default: `npm run dev` talks to the real backend. Turn it on to work on
# the UI with no backend running, or to drive a state the real one will not
# produce on demand — a 429, a stalled stream, a degraded index. See
# src/mocks/scenarios.ts for the list.
#
# When it is on, the browser console says so on every load. The fixtures are
# convincing on purpose, which is exactly why demoing them by accident is easy.
VITE_ENABLE_MOCKS=false

# Feature flags. Set to "false" to switch a capability off from the deploy
# dashboard without a code change — which is the point: if voice or charts
# misbehave an hour before the demo, they can be turned off in a redeploy.
VITE_ENABLE_VOICE=true
VITE_ENABLE_CHARTS=true

# How long to wait for the stream before giving up, in milliseconds.
# A traveller on roaming data would rather see an honest error than a spinner.
VITE_STREAM_TIMEOUT_MS=30000

# Exact origin allowed to embed the widget (F11). Use a full origin, not a
# hostname, and not "*".
VITE_EMBED_ALLOWED_ORIGIN=https://www.scaspa.com
