# ---- Secrets: never commit ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# uv.lock IS committed — CI installs from it for reproducible builds.

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Generated data ----
# Vector index and scraped pages are build artifacts, not source.
data/chroma/*
!data/chroma/.gitkeep
data/scraped/*
!data/scraped/.gitkeep
# The client-facing report IS committed: it is the actionable deliverable from a
# crawl. The JSONL, the PDFs (16MB) and the dated diffs are build artifacts.
!data/scraped/flagged_for_client.md
# Written by scripts/build_index.py and specific to a local index.
data/index_meta.json
# Synthesised speech, cached to avoid paying twice for the same sentence.
data/tts_cache/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
