# ---- Secrets: never commit ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# uv.lock IS committed — CI installs from it for reproducible builds.

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Generated data ----
# Vector index and scraped pages are build artifacts, not source.
data/chroma/*
!data/chroma/.gitkeep
data/scraped/*
!data/scraped/.gitkeep
# The client-facing report IS committed: it is the actionable deliverable from a
# crawl. The JSONL, the PDFs (16MB) and the dated diffs are build artifacts.
!data/scraped/flagged_for_client.md
# Written by scripts/build_index.py and specific to a local index.
# Watchtower's structured store. A cache of what SCASPA publishes, rebuilt by
# running the monitor — the same reasoning as data/chroma above. Committing it
# would put a snapshot of the cruise schedule in git, where it would go stale
# and then be believed.
data/operational.sqlite3
data/operational.sqlite3-*

data/index_meta.json
# Question log and its exports. Real questions from real people belong to
# SCASPA, not in a public repo.
data/questions.jsonl
data/questions_*.csv
# Synthesised speech, cached to avoid paying twice for the same sentence.
data/tts_cache/

# Eval runs and history ARE committed: the accuracy-over-time line cannot be
# reconstructed later, so every run is kept from the first bad measurement on.

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/

# Voice smoke-test output. Generated by scripts/voice_smoke.py for listening to;
# never a build artefact and never worth committing.
backend/voice_*.mp3
