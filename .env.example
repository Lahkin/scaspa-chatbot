# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- OpenAI credentials ---
OPENAI_API_KEY=                        # OpenAI secret key; the app will not start a real LLM call without it
OPENAI_CHAT_MODEL=                     # Chat model id, e.g. gpt-5.6-terra (see developers.openai.com/api/docs/models)
OPENAI_EMBEDDING_MODEL=                # Embedding model id used to build and query the Chroma index
OPENAI_TRANSCRIBE_MODEL=               # Speech-to-text model id for the voice endpoint
OPENAI_TTS_MODEL=                      # Text-to-speech model id used to speak answers back
OPENAI_TTS_VOICE=                      # Built-in TTS voice name, e.g. marin

# --- Generation limits ---
CHAT_TEMPERATURE=                      # Sampling temperature; 0 keeps answers deterministic and on-source
MAX_OUTPUT_TOKENS=                     # Hard cap on tokens in a single assistant answer
AGENT_MAX_TOOL_CALLS=                  # Max tool invocations per turn before the agent must answer

# --- Upstream resilience ---
OPENAI_TIMEOUT_SECONDS=                # Per-call timeout; an honest error beats an endless spinner
OPENAI_MAX_ATTEMPTS=                   # Total attempts per call, including the first (retries 429/5xx only)
OPENAI_BACKOFF_BASE_SECONDS=           # First backoff delay; doubles each retry

# --- Request limits ---
MAX_MESSAGE_CHARS=                     # Longest question accepted; longer gets a 422

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=                       # Chunks passed to the model after re-ranking
RETRIEVAL_FETCH_K=                     # Candidates pulled from Chroma before re-ranking
RETRIEVAL_MIN_SCORE=                   # Similarity floor; below this a chunk is dropped rather than cited

# --- Paths (relative to backend/) ---
KB_CSV_PATH=                           # Curated knowledge-base CSV that feeds the index
CHROMA_DIR=                            # Chroma persistence directory
SCRAPED_DIR=                           # Where the site scraper writes raw pages

# --- Service ---
ALLOWED_ORIGINS=                       # Comma-separated CORS origins allowed to call this API
RATE_LIMIT_PER_MINUTE=                 # Per-client request cap per minute
MAX_HISTORY_TURNS=                     # Conversation turns kept as context
CONVERSATION_TTL_MINUTES=              # Idle minutes before a conversation is discarded

# --- Scraper ---
SCRAPER_USER_AGENT=                    # User-Agent the scraper identifies itself with
SCRAPER_BLOCKLIST=                     # Comma-separated hosts the scraper must never fetch (keep pay.scaspa.com here)

# --- Runtime ---
ENV=                                   # dev | staging | prod
LOG_LEVEL=                             # DEBUG | INFO | WARNING | ERROR
