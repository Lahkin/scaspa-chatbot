# Copy to backend/.env and fill in what you need.
#
# Every key below is OPTIONAL except OPENAI_API_KEY — a blank or missing value
# falls back to the documented default, so you can copy this file as-is and the
# app will start.
#
# Comments are on their own lines on purpose. python-dotenv treats an inline
# "# comment" after a key as part of the VALUE, so `FOO=  # note` sets FOO to
# "# note". That broke the README's own first step until it was tested.
#
# .env is gitignored and must never be committed. Only this file is.

# =============================== OpenAI ===============================

# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model ids from https://developers.openai.com/api/docs/models
# Defaults: gpt-5.6-terra, text-embedding-3-large, gpt-transcribe,
#           gpt-4o-mini-tts, marin
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# ========================= Generation limits ==========================

# 0 keeps answers deterministic and on-source. Default 0.
CHAT_TEMPERATURE=
# Hard cap on tokens in one answer. Default 700.
MAX_OUTPUT_TOKENS=
# Max tool calls per turn before the agent must answer. Default 6.
AGENT_MAX_TOOL_CALLS=

# ======================== Upstream resilience =========================

# Per-call timeout. An honest error beats an endless spinner. Default 20.
OPENAI_TIMEOUT_SECONDS=
# Total attempts including the first; retries 429 and 5xx only. Default 3.
OPENAI_MAX_ATTEMPTS=
# First backoff delay, doubling each retry. Default 0.5.
OPENAI_BACKOFF_BASE_SECONDS=

# ============================= Retrieval ==============================

# Chunks passed to the model. Default 5.
RETRIEVAL_TOP_K=
# Candidates fetched before reranking. Default 20.
RETRIEVAL_FETCH_K=
# Similarity floor; below this the model is not called at all. Default 0.30.
# Re-tune with `scripts/evaluate.py --sweep-min-score` against real embeddings —
# this number is entirely embedding-dependent.
RETRIEVAL_MIN_SCORE=

# Retrieval techniques, independently toggleable.
# Defaults: rewrite on, category on, hybrid off, rerank off.
RETRIEVAL_QUERY_REWRITE=
RETRIEVAL_CATEGORY_FILTER=
RETRIEVAL_HYBRID=
RETRIEVAL_RERANK=

# =============================== Paths ================================
# Relative to backend/.

KB_CSV_PATH=
CHROMA_DIR=
SCRAPED_DIR=
# Where question text is appended for scripts/export_questions.py.
# Never holds an identifier.
QUESTION_LOG_PATH=

# =============================== Service ==============================

# Comma-separated CORS origins. A wildcard with ENV=prod refuses to boot.
ALLOWED_ORIGINS=
# Per-client requests per minute. Voice gets a third of this. Default 15.
RATE_LIMIT_PER_MINUTE=
# Conversation turns kept, and idle minutes before one is dropped.
MAX_HISTORY_TURNS=
CONVERSATION_TTL_MINUTES=
# Longest question accepted; longer gets a friendly 422. Default 1000.
MAX_MESSAGE_CHARS=

# ============================ Cost controls ===========================
# Set these from the current OpenAI pricing page, or the spend estimate is 0.
# NOTE: the real protection is a hard monthly cap on the OpenAI ACCOUNT.
# This estimate only sees what the application does.

PRICE_CHAT_INPUT_PER_MTOK=
PRICE_CHAT_OUTPUT_PER_MTOK=
PRICE_EMBEDDING_PER_MTOK=
PRICE_TRANSCRIBE_PER_MINUTE=
PRICE_TTS_PER_MCHAR=
# Log a warning once the daily estimate passes this. Default 5.
DAILY_SPEND_WARN_USD=

# ================================ Admin ===============================

# Unset removes /api/admin/stats entirely. Set a long random string in prod.
ADMIN_SECRET=

# =============================== Scraper ==============================

SCRAPER_USER_AGENT=
# Comma-separated hosts the scraper must NEVER fetch.
# Keep pay.scaspa.com here — it is a live payment portal.
SCRAPER_BLOCKLIST=

# =============================== Runtime ==============================

# dev | staging | prod
ENV=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
# true for structured JSON logs. Default true.
LOG_JSON=
